# Copy to .env.local and fill from Supabase → Connect (or Settings → API Keys).
# Without these, the store uses built-in sample products and /admin shows setup steps.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use either the publishable key (sb_publishable_…) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — secret (sb_secret_…) or legacy service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Optional: production URL for link previews
NEXT_PUBLIC_SITE_URL=
