# Copy to .env.local and fill from Supabase → Project Settings → API.
# Without these, the store uses built-in sample products and /admin shows setup steps.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: production URL for link previews
NEXT_PUBLIC_SITE_URL=
